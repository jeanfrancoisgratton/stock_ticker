# Maintainer: J.F. Gratton <jean-francois@famillegratton.net>
# Packager: Build packager <builder@famillegratton.net>
pkgname=stockticker
pkgver=0.0.1
pkgrel=4
pkgdesc="Stock Ticker game adaptation"
url="https://git.famillegratton.net:3000/mainline/stock_ticker.git"
arch=x86_64
license=GPL2
#depends="gcompat"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-upgrade $pkgname.post-upgrade $pkgname.pre-deinstall $pkgname.post-deinstall"
#source="$pkgname-$pkgver-$pkgrel.tar.bz2::http://localhost/$pkgname-$pkgver-$pkgrel.tar.bz2"
builddir="$startdir/src/BUILD"

binaryname=stockticker
binaryname_daemon="${binaryname}Daemon"

prepare() {
	mkdir -p "$builddir"
	cp -R "$startdir"/../src/* "$builddir"/
}

build() {
	cd "$builddir"

	go env | egrep 'GOFLAGS|CGO_ENABLED|GOOS|GOARCH' || true

	# Static, non-PIE, internal linker. One module, two entrypoints under it.
	go build -trimpath -ldflags="-s -w -buildid= -linkmode=internal" -o "$binaryname" ./client
	go build -trimpath -ldflags="-s -w -buildid= -linkmode=internal" -o "$binaryname_daemon" ./daemon
}

package() {
	install -d "$pkgdir"/opt/bin "$pkgdir"/opt/sbin
	install -m755 "$builddir/$binaryname" "$pkgdir/opt/bin/$binaryname"
	install -m755 "$builddir/$binaryname_daemon" "$pkgdir/opt/sbin/$binaryname_daemon"
}
